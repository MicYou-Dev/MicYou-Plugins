{
  "id": "opss.whatdidisay",
  "name": "WhatdidIsay",
  "version": "0.2.5",
  "description": "Transcribe your talk into text records every time you use MicYou. ",
  "descriptionI18n": {
    "zh": "在后台把你说的话实时转录成文字记录。",
    "zh-CN": "在后台把你说的话实时转录成文字记录。"
  },
  "nameI18n": {
    "zh": "实时语音转录",
    "zh-CN": "实时语音转录"
  },
  "license": "Unlicense",
  "runtime": "native",
  "entry": "WhatdidIsay",
  "platforms": ["linux", "windows", "macos"],
  "arches": ["x86_64", "aarch64"],
  "minHostVersion": "2.0.3",
  "apiVersion": 1,
  "capabilities": [
    "config.read",
    "config.write",
    "dsp.node",
    "message.send"
  ],
  "kind": "dsp",
  "dsp": { "insertAfter": "AEC" },
  "keywords": [
    "speech-to-text",
    "transcription",
    "asr",
    "offline",
    "sherpa-onnx",
    "qwen3",
    "vad",
    "records"
  ],
  "config": {
    "loadTiming": "device_connect",
    "notifyModelStatus": true
  },
  "configSchema": {
    "fields": [
      {
        "key": "loadTiming",
        "fieldType": "select",
        "label": "模型加载时机",
        "default": "device_connect",
        "options": [
          { "value": "micyou_start", "label": "MicYou 启动时" },
          { "value": "device_connect", "label": "设备连接时" }
        ]
      },
      {
        "key": "notifyModelStatus",
        "fieldType": "boolean",
        "label": "模型状态通知",
        "default": true
      }
    ]
  },
  "repository": "https://github.com/OrientCOMPASS/WhatdidIsay",
  "homepage": "https://github.com/OrientCOMPASS/WhatdidIsay",
  "updateUrl": "https://github.com/OrientCOMPASS/WhatdidIsay/releases/latest/download/plugin.json",
  "downloadUrl": "https://github.com/OrientCOMPASS/WhatdidIsay/releases/latest/download/opss.whatdidisay.zip",
  "readmeUrl": "https://raw.githubusercontent.com/OrientCOMPASS/WhatdidIsay/refs/heads/main/README.md"
}
